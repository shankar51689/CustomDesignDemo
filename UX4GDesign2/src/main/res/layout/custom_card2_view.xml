<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cv"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="0dp"
    app:cardElevation="-10dp"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitleCircle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SM"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/UX4G_primary_800"
            android:textAlignment="center"
            android:background="@drawable/bg_circle_text"
            android:padding="10dp"
            android:visibility="visible"
            android:layout_marginStart="8dp"/>

        <com.example.ux4gdesign2.components.CircularImageView
            android:id="@+id/civ"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/test_image"
            android:padding="5dp"
            android:visibility="gone"
            />


        <!-- Text Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:layout_marginVertical="8dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="List Item"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:textColor="@android:color/black"/>

            <TextView
                android:id="@+id/supportingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Supporting text"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:maxLines="3"
                android:textColor="@android:color/darker_gray"/>
        </LinearLayout>

        <!-- CheckBox -->
        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/checkBoxRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible"/>

        <!-- Arrow Icon -->
        <ImageView
            android:id="@+id/arrowIconRight"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_arrow_right"
            android:visibility="gone"/>

        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/radioButtonRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible"/>

        <!-- Toggle Switch -->
        <com.example.ux4gdesign2.components.switchButtons.CustomSwitchButton
            android:id="@+id/toggleSwitchRight"
            android:layout_width="40dp"
            android:layout_height="20dp"
            android:checked="false"
            android:visibility="visible"
            android:layout_marginEnd="6dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
